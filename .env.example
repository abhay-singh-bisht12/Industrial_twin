# IndustrialTwin Environment Configuration Template
# Copy this file to .env for custom local or production deployments

# --- Backend Application ---
PROJECT_NAME=IndustrialTwin
ENVIRONMENT=development
LOG_LEVEL=INFO
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=dev_secret_key_industrial_twin

# --- MQTT Broker ---
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_WS_PORT=9001
MQTT_CLIENT_ID=industrial_twin_backend
MQTT_TELEMETRY_TOPIC=industrial/motor/+/telemetry
MQTT_ALERT_TOPIC=industrial/motor/+/alerts
MQTT_CONTROL_TOPIC=industrial/motor/+/control

# --- MongoDB Database ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=industrial_twin
MONGO_TELEMETRY_COLLECTION=telemetry
MONGO_ALERTS_COLLECTION=alerts

# --- Machine Learning Engine ---
ML_MODEL_PATH=ml/models/health_model.joblib
ML_ANOMALY_THRESHOLD=0.65

# --- Digital Twin Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000/api/v1/ws/telemetry

# --- Grafana Dashboard ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin_secure_password
